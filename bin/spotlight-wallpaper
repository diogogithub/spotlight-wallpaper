#!/usr/bin/env python3
"""Fetch a landscape Spotlight image, validate it, and atomically replace a local file."""
from __future__ import annotations

import argparse
import datetime
import os
import struct
import sys
import tempfile
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "lib"))
from extract_url import score, strings  # noqa: E402


def image_size(data: bytes) -> tuple[int, int]:
    if data.startswith(b"\x89PNG\r\n\x1a\n") and len(data) >= 24:
        return struct.unpack(">II", data[16:24])
    if data.startswith(b"RIFF") and data[8:12] == b"WEBP" and len(data) >= 30:
        kind = data[12:16]
        if kind == b"VP8X":
            return 1 + int.from_bytes(data[24:27], "little"), 1 + int.from_bytes(data[27:30], "little")
        if kind == b"VP8 " and data[23:26] == b"\x9d\x01\x2a":
            return struct.unpack("<H", data[26:28])[0] & 0x3FFF, struct.unpack("<H", data[28:30])[0] & 0x3FFF
        if kind == b"VP8L" and data[20:21] == b"\x2f":
            bits = int.from_bytes(data[21:25], "little")
            return 1 + (bits & 0x3FFF), 1 + ((bits >> 14) & 0x3FFF)
    if data.startswith(b"\xff\xd8"):
        offset = 2
        while offset + 4 < len(data):
            if data[offset] != 0xFF:
                break
            while offset < len(data) and data[offset] == 0xFF:
                offset += 1
            marker = data[offset]
            offset += 1
            if marker in (0xD8, 0xD9, *range(0xD0, 0xD8), 0x01):
                continue
            if offset + 2 > len(data):
                break
            length = struct.unpack(">H", data[offset:offset + 2])[0]
            if length < 2 or offset + length > len(data):
                break
            if marker in (0xC0, 0xC1, 0xC2, 0xC3, 0xC5, 0xC6, 0xC7, 0xC9, 0xCA, 0xCB, 0xCD, 0xCE, 0xCF):
                if length >= 7:
                    h, w = struct.unpack(">HH", data[offset + 3:offset + 7])
                    return w, h
                break
            offset += length
    raise ValueError("Not a supported JPEG, PNG, or WebP image")


def fetch(url: str, limit: int) -> bytes:
    request = urllib.request.Request(url, headers={"User-Agent": "WindowsShellClient/0"})
    with urllib.request.urlopen(request, timeout=35) as response:
        data = response.read(limit + 1)
    if not data or len(data) > limit:
        raise ValueError("Empty or oversized response")
    return data


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--output", default=os.environ.get("SPOTLIGHT_OUTPUT", str(Path.home() / ".local/share/backgrounds/spotlight.jpg")))
    parser.add_argument("--width", type=int, default=int(os.environ.get("SPOTLIGHT_WIDTH", "1920")))
    parser.add_argument("--height", type=int, default=int(os.environ.get("SPOTLIGHT_HEIGHT", "1080")))
    parser.add_argument("--min-width", type=int, default=int(os.environ.get("SPOTLIGHT_MIN_WIDTH", "1600")))
    parser.add_argument("--min-height", type=int, default=int(os.environ.get("SPOTLIGHT_MIN_HEIGHT", "900")))
    parser.add_argument("--locale", default=os.environ.get("SPOTLIGHT_LOCALE", "en-US"))
    parser.add_argument("--country", default=os.environ.get("SPOTLIGHT_COUNTRY", "US"))
    args = parser.parse_args()
    if min(args.width, args.height, args.min_width, args.min_height) <= 0:
        parser.error("dimensions must be positive")
    # Windows 10 Spotlight v3: Placement is the documented delivery endpoint.
    # Cache is kept as a fallback for regions in which it still supplies images.
    params = {
        "pid": "209567", "fmt": "json", "rafb": "0",
        "ua": "WindowsShellClient/0", "cdm": "1", "lo": "80217",
        "disphorzres": str(args.width), "dispvertres": str(args.height),
        "pl": args.locale, "lc": args.locale,
        "ctry": args.country.lower(),
        "time": datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
    }
    query = urllib.parse.urlencode(params)
    endpoints = [
        ("Placement", "https://arc.msn.com/v3/Delivery/Placement?" + query),
        ("Placement (alternative host)", "https://fd.api.iris.microsoft.com/v3/Delivery/Placement?" + query),
        ("Cache", "https://arc.msn.com/v3/Delivery/Cache?" + query),
    ]
    errors = []
    try:
        import json
        for source, endpoint in endpoints:
            try:
                payload = json.loads(fetch(endpoint, 3_000_000))
            except (OSError, ValueError, urllib.error.URLError) as exc:
                errors.append(f"{source}: {exc}")
                continue

            candidates = sorted(
                ((score(path, url), url) for path, url in strings(payload)),
                key=lambda item: item[0], reverse=True,
            )
            urls = list(dict.fromkeys(
                url for rating, url in candidates
                if rating >= 5 and url.startswith("https://")
            ))
            if not urls:
                batch = payload.get("batchrsp", {}) if isinstance(payload, dict) else {}
                server_errors = batch.get("errors", []) if isinstance(batch, dict) else []
                details = str(server_errors)[:200] if server_errors else "no landscape image URLs"
                errors.append(f"{source}: {details}")
                continue

            for url in urls[:5]:
                try:
                    data = fetch(url, 30_000_000)
                    width, height = image_size(data)
                    if width < args.min_width or height < args.min_height:
                        raise ValueError(
                            f"image {width}x{height} below minimum "
                            f"{args.min_width}x{args.min_height}"
                        )
                    if width > 16000 or height > 16000 or width * height > 100_000_000:
                        raise ValueError("implausible image dimensions")
                    output = Path(args.output).expanduser()
                    output.parent.mkdir(parents=True, exist_ok=True)
                    temp_path = None
                    try:
                        with tempfile.NamedTemporaryFile(
                            prefix=".spotlight.", dir=output.parent, delete=False,
                        ) as temp:
                            temp_path = Path(temp.name)
                            temp.write(data)
                        os.chmod(temp_path, 0o644)
                        os.replace(temp_path, output)
                    finally:
                        if temp_path is not None:
                            temp_path.unlink(missing_ok=True)
                    print(f"{output} ({width}x{height}, {source})")
                    return 0
                except (OSError, ValueError, urllib.error.URLError) as exc:
                    errors.append(f"{source} image: {exc}")

        raise ValueError(
            "No valid Microsoft Spotlight wallpaper from the available endpoints. "
            + "; ".join(errors)
        )
    except (OSError, ValueError, urllib.error.URLError) as exc:
        print(f"spotlight-wallpaper: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
